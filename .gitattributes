* text=auto
*.3ds binary
*.3dm binary
*.png binary
*.jpg binary
*.csv text eol=crlf

# Bundled shaders retain upstream whitespace inside JavaScript string literals.
index.html -whitespace linguist-generated=true
package-lock.json linguist-generated=true

# Preserve the upstream font license text, including its original whitespace.
assets/fonts/OFL.txt -whitespace

assets/viewer.bundle.js -whitespace linguist-generated=true
assets/model-local.js -whitespace linguist-generated=true
